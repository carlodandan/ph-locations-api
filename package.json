{
  "name": "philippine-locations-api",
  "version": "1.0.0",
  "private": true,
  "description": "Philippine administrative locations REST API on Cloudflare Workers",
  "author": "Carlo Dandan <carlodandan.personal@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlodandan/ph-locations-api.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-data": "tsx --tsconfig scripts/tsconfig.json scripts/validate-data.ts",
    "split-barangays": "tsx --tsconfig scripts/tsconfig.json scripts/split-barangays.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\""
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20240925.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "wrangler": "^4.35.0"
  }
}
